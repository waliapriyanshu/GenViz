# Genviz environment template.
#
# Copy this file to .env.local for local development:   cp .env.example .env.local
# On Vercel, set the same names in Project Settings > Environment Variables.
#
# SECURITY: this file is tracked by git and must contain placeholders only.
# Never put a real key, token or password in it. .env, .env.local and every
# other .env.* file are listed in .gitignore. If a real credential is ever
# committed, treat it as compromised: revoke or rotate it first, then remove it
# from the repository history.

# --- Required ---------------------------------------------------------------

# Genviz's own PostgreSQL database (Neon works well). It stores sources,
# conversations and rate limits (schema "genviz") and uploaded datasets (schema
# "genviz_data"). Use a dedicated database and role for Genviz.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# AI model provider key (Groq). Create one at https://console.groq.com/keys
GROQ_API_KEY=""

# Application secrets. Use long random values and generate them yourself:
#   openssl rand -base64 32
# Both are required in production. Use a different value for every environment.
# GENVIZ_SESSION_SECRET signs the anonymous session cookie.
# GENVIZ_ENCRYPTION_KEY encrypts stored database connection strings. Changing it
# makes existing saved connections unreadable (users reconnect).
GENVIZ_SESSION_SECRET=""
GENVIZ_ENCRYPTION_KEY=""

# --- Optional: model and provider -------------------------------------------

# Defaults are shown. LLM_FALLBACK is a comma-separated list of provider:model.
# LLM_PROVIDER="groq"
# LLM_MODEL="openai/gpt-oss-120b"
# LLM_FALLBACK="groq:openai/gpt-oss-20b"
# GROQ_BASE_URL=""                          # for example an AI gateway in front of Groq

# --- Optional: rate limiting ------------------------------------------------

# Minimum seconds between questions per browser session (enforced on the server).
# 60 suits Groq's free tier (8K tokens per minute; one question uses about 4K to 7K).
# Use 0 on a paid tier.
# QUERY_RATE_LIMIT_SECONDS=60
# QUERY_IP_RATE_LIMIT_SECONDS=10
# PROVIDER_RATE_LIMIT_FALLBACK_SECONDS=30   # used when the provider sends no Retry-After

# --- Optional: query safety limits ------------------------------------------

# QUERY_STATEMENT_TIMEOUT_MS=10000
# DB_CONNECT_TIMEOUT_MS=5000
# MAX_RESULT_ROWS=5000

# --- Optional: uploads ------------------------------------------------------

# Vercel functions accept request bodies up to 4.5 MB.
# MAX_UPLOAD_BYTES=4194304
# MAX_CSV_ROWS=200000

# --- Development only -------------------------------------------------------

# Allow connecting to databases on localhost or private networks. Never enable
# this in production: it disables the protection against server-side request forgery.
# ALLOW_PRIVATE_DB_HOSTS=true

# --- Tests (optional) -------------------------------------------------------

# Database integration tests run only when these are set. Point them at a
# throwaway database, never at production data.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/genviz_test"
# TEST_SALES_DB_URL=""
# TEST_SALES_DB_RW_URL=""
