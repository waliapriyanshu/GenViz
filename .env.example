# Copy to .env.local for local development. Never commit real values.

# --- Required ---------------------------------------------------------------
# Genviz's own Postgres (Neon works). Stores sources, conversations, rate limits
# (schema "genviz") and uploaded datasets (schema "genviz_data").
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# AI model (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# Secrets (any long random strings; e.g. `openssl rand -base64 32`).
# Required in production. The encryption key protects stored database connection strings.
GENVIZ_SESSION_SECRET=""
GENVIZ_ENCRYPTION_KEY=""

# --- Optional ---------------------------------------------------------------
# Model/provider (defaults shown). LLM_FALLBACK is a comma-separated provider:model list.
# LLM_PROVIDER="groq"
# LLM_MODEL="openai/gpt-oss-120b"
# LLM_FALLBACK="groq:openai/gpt-oss-20b"
# GROQ_BASE_URL=""                      # e.g. an AI gateway/proxy in front of Groq

# Minimum seconds between questions per browser session (backend-enforced).
# 60s suits Groq's free tier (8K tokens/min; one question uses ~4-6K). Use 0 on a paid tier.
# QUERY_RATE_LIMIT_SECONDS=60
# QUERY_IP_RATE_LIMIT_SECONDS=10
# PROVIDER_RATE_LIMIT_FALLBACK_SECONDS=30   # used when the provider sends no Retry-After

# Query safety limits
# QUERY_STATEMENT_TIMEOUT_MS=10000
# DB_CONNECT_TIMEOUT_MS=5000
# MAX_RESULT_ROWS=5000

# Uploads (Vercel functions accept request bodies up to 4.5 MB)
# MAX_UPLOAD_BYTES=4194304
# MAX_CSV_ROWS=200000

# Local development only: allow connecting to databases on localhost/private networks.
# ALLOW_PRIVATE_DB_HOSTS=true
