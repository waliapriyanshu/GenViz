# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (never commit secrets); only the template .env.example is tracked
.env
.env.*
!.env.example

# keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
service-account*.json
credentials*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local databases
*.db
*.sqlite
*.sqlite3
